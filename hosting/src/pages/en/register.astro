---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerticalLayout from "../../components/layout/VerticalLayout.vue";
import BrandingPattern from "@components/branding/BrandingPattern.vue";
---
<BaseLayout showMainNav={false} alwaysShowLogoLabel={true}>
    <VerticalLayout class="md:gap-0 grow bg-white pt-28">
        <div class="w-full mx-auto grow bg-white relative flex flex-col">
            <div class="absolute left-0 top-0 bottom-0 md:right-[calc(50%+565px)] bg-red-800/90">
                <div class="absolute top-0 right-0 bottom-0 w-14 bg-white/10">
                    <BrandingPattern></BrandingPattern>
                </div>
            </div>
            <div class="relative grow">
                <iframe
                        class="absolute inset-0"
                        src="https://forms.gle/bfXsmgis4Rio3mM56"
                        width="100%"
                        height="100%"
                        frameborder="0" marginheight="0" marginwidth="0">Loading…
                </iframe>
            </div>
        </div>
    </VerticalLayout>
</BaseLayout>
