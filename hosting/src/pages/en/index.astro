---
import {getLangFromUrl} from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerticalLayout from "../../components/layout/VerticalLayout.vue";
import NavigationBar from "../../components/sections/NavigationBar.vue";
import HeroSection from "../../components/sections/HeroSection.vue";
import InfoSection from "../../components/sections/Info.vue";
import ForumSection from "@components/sections/Forum.vue";
import ExpoSection from "@components/sections/Expo.vue";
import SpeakerSection from "../../components/sections/Speakers.vue";
import SpeakersCard from "@components/sections/SpeakersCard.vue";
import TimetableSection from "../../components/sections/Timetable.vue";
import Sponsors from "../../components/sections/Sponsors.vue";
import Register from "../../components/sections/Register.vue";
import Footer from "../../components/sections/Footer.vue";
import MessageSection from "../../components/sections/Message.vue";
import TimetableEntry from "@components/sections/TimetableEntry.vue";
import TimetableEntrySection from "@components/sections/TimetableEntrySection.vue";
import PrimaryButton from "../../components/base/PrimaryButton.vue";

import DavidMessageFromPresidentImg from "../../assets/osaka-africa-business-forum/data_545.jpg";
import SackoMessageImg from "../../assets/osaka-africa-business-forum/data_330.jpg";

import ChickeImg from "@assets/osaka-africa-business-forum/chike-c-nwoffiah.jpg";

const lang = getLangFromUrl(Astro.url);
---
<BaseLayout>
    <VerticalLayout class="md:gap-0">
        <HeroSection lang={lang} client:load></HeroSection>
        <InfoSection lang={lang} id="info">
            <span slot="title">
                From Osaka EXPO to Green EXPO
                <br>
                Growing together with Africa
                <br>
                through green innovation
            </span>
            <span slot="description">
                Following the 2025 Osaka-Kansai Expo and TICAD9, this one-day forum turns partnerships, MoUs and business relationships into concrete trade, investment and implementation. With GREEN×EXPO 2027 on the horizon, the programme focuses on renewable energy, sustainable agriculture, environmental technology, climate action and youth-led green entrepreneurship.
            </span>
            <span slot="card-1-title">
                Post-Expo commercialization
            </span>
            <span slot="card-1-content">
                Move 2025 business matches and MoUs from pilot projects toward full business and investment.
            </span>
            <span slot="card-2-title">
                Green industry and agri-business
            </span>
            <span slot="card-2-content">
                Create Japan–Africa collaboration models in environmental technology, renewable energy, sustainable agriculture and food innovation.
            </span>
            <span slot="card-3-title">
                Kansai technology and entrepreneurship
            </span>
            <span slot="card-3-content">
                Match Higashiosaka and Kansai SMEs with African market needs, while connecting youth- and diaspora-led ventures with investors and implementation partners.
            </span>
        </InfoSection>
        <ForumSection lang={lang} id="forum">
            <span slot="title">
                Africa Business Forum-Osaka 2026
            </span>
            <span slot="description">
                A practical one-day programme for government, business, investment, research and diaspora leaders from Japan and Africa.
            </span>

            <span slot="venue-name">
                Higashiosaka City Cultural Creation Hall
            </span>
            <span slot="venue-address">
                2-3-4 Mikuriya Minami, Higashi-Osaka City, Osaka 577-0034 Japan · 22 October 2026 · 10:00–20:30
            </span>

            <span slot="card-1-title">
                Green innovation
            </span>
            <span slot="card-1-content">
                “From OSAKA EXPO to Green Future” — moving from visibility to implementation and sustainable growth.
            </span>
            <span slot="card-2-title">
                Africa market access
            </span>
            <span slot="card-2-content">
                Practical guidance on partners, distributors, local production, technology transfer, joint ventures, regulation, financing and regional markets including EAC, ECOWAS and AfCFTA.
            </span>
            <span slot="card-3-title">
                Start-up pitches
            </span>
            <span slot="card-3-content">
                Japanese and Japan-based African entrepreneurs present green and social innovation models, followed by investor comments.
            </span>
            <span slot="card-4-title">
                Booth networking
            </span>
            <span slot="card-4-content">
                Embassy, partner and sponsor booths support targeted B2B, B2G, G2G and university matching.
            </span>

            <span slot="register-title">
                Register as partner or sponsor
            </span>
            <span slot="register-content">
                For people interested in becoming partner or sponsor, etc.
            </span>
            <span slot="register-button">
               <a href="https://forms.gle/LrEHbNAmjjBwm9Yx6"
                  class="text-sm text-white-800 font-bold mt-5 ">Contact Us</a>
            </span>

        </ForumSection>
        <ExpoSection lang={lang} id="expo">
            <span slot="title">
                Discover Africa Expo, Matsuri
            </span>
            <span slot="subtitle">
                Experience the real Africa
            </span>
            <span slot="description">
                The second day of the event serves as a
                platform for citizens, companies, and African embassies in Japan to showcase their products,
                services, and cultural heritage.
            </span>

            <span slot="venue-name">
                Higashiosaka Hanazono Central Park
            </span>
            <span slot="venue-address">
                1-1-43 Matsubara-Minami, Higashiosaka-shi, Osaka 578-0923 Japan
            </span>

            <span slot="business-card-1-title">
                Booths
            </span>
            <span slot="business-card-1-content">
                Booths by African embassies in Japan with B-to-B meeting. Booths set up by company,
                Governmental partners including overseas expansion support organizations
            </span>
            <span slot="business-card-2-title">
                B2B Meeting Area
            </span>
            <span slot="business-card-2-content">
                This is a designated area set for business-to-business (B2B) interactions. The space is designed for attendees to arrange and conduct business meetings and conclude business deals in the business area.
            </span>

            <span slot="expo-card-1-title">
                Opening Ceremony
            </span>
            <span slot="expo-card-1-content">
                Opening Ceremony with welcoming speeches from distinguished guests including government and diplomatic officials.
            </span>
            <span slot="expo-card-2-title">
                African Marketplace
            </span>
            <span slot="expo-card-2-content">
                African marketplace with exhibitors from various African countries, showcasing a diverse range of products, such as textiles, handcraft, art, jewelry, food, and beverages.
            </span>
            <span slot="expo-card-3-title">
                Cultural Performances
            </span>
            <span slot="expo-card-3-content">
                Cultural performances with Folk music and live artists with a fashion show.
            </span>
            <span slot="expo-card-4-title">
                Presentations
            </span>
            <span slot="expo-card-4-content">
                Chike Nwoffiah, founder of the Silicon Valley Africa Film Festival (SVAFF).
               Topic: The Potential of creative business in Africa
            </span>

            <span slot="register-title">
                Register as partner
            </span>
            <span slot="register-content">
                For people interested in having a booth, performing, or selling food, etc.
            </span>
            <span slot="register-button">
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSeMVtqMWbR30hYYh92voAHezWdY3_bQmEU_MR4Kbq-uLfT0Lg/viewform"
                   class="text-sm text-white-800 font-bold mt-5 ">Contact Us</a>
            </span>
        </ExpoSection>
        <MessageSection lang={lang} id="message" image={DavidMessageFromPresidentImg}>
            <span slot="title">Letter from the President</span>
            <strong>Welcome to Africa Business Forum-Osaka 2026</strong>
            <p>
                Africa Diaspora Network Japan (ADNJ) welcomes you to Africa Business Forum-Osaka 2026, held on Thursday, October 22 at Higashiosaka City Cultural Creation Hall.
            </p>
            <p>
                Under the theme “From Osaka EXPO to Green EXPO: Growing together with Africa”, the Forum moves beyond dialogue to practical green innovation, market access and co-creation.

            </p>
            <p>
               Since the launch of the Discover Africa initiative in 2020, ADNJ has worked to deepen mutual understanding and unlock collaborative potential between African and Japanese enterprises. Following two years of successful forums centered on discovering and connecting with Africa,
               we are now carving new paths together with concrete business opportunities.
            </p>
             <p>
              By participating as a sponsor, partner, or volunteer, you will help strengthen a vibrant ecosystem that empowers innovation, entrepreneurship, and trust across borders.
            </p>
            <p>
              Join us in building this future, with Africa.
            </p>
             <p>
              Register now and see you soon!
            </p>
            <p slot="signature">David Kpondehou</p>
            <div slot="image-caption">
                <p class="font-bold mb-2">David Kpondehou</p>
                <p>President, Africa Diaspora Network Japan (ADNJ)</p>
            </div>
        </MessageSection>
        <MessageSection lang={lang} image={SackoMessageImg} order="inverted">
            <span slot="title">Message from Osaka Africa Business Forum Executive Committee Chairperson</span>
             <p>Dear Everyone,</p>
            <p>
                "Walking Together with Africa" is the theme for this year's Osaka Africa Business Forum. We warmly
                welcome the participation of business professionals, small and medium-sized enterprise owners, and the general public.
            </p>
            <p>
               Africa is a continent rich in natural resources and diverse cultures. Its abundance of resources, such as gold, oil, and agricultural products, 
               holds significant potential for sustainable economic growth. Furthermore, Africa offers unique business opportunities backed by its rich history and traditions.
                Particularly noteworthy is Africa's young population. In 50 years, it is projected that one-quarter of the world's population will come from Africa, with over
                half being under the age of 18. The energy and innovation of these young people will drive entrepreneurship and technological advancements, enhancing competitiveness 
                in the global market.

            </p>
            <p>
               ADNJ will collaborate with the city of Higashi-Osaka to provide a valuable platform for dialogue with Africa. This year, in addition to the Africa Expo and Africa Forum, 
               we have a special event with dozens of business professionals invited from Africa, allowing for direct interaction. Through this valuable opportunity, let's experience Africa's 
               charm and take the first step towards building a shared future together.

            </p>
            <p>
                We sincerely look forward to your participation.

            </p>
            <p slot="signature">Dr. Oussouby SACKO</p>
            <div slot="image-caption">
                <p class="font-bold mb-2">Dr. Oussouby SACKO</p>
                <p>OABF Executive Committee Chairman and Vice President of the Japan International Exposition 2025 Association
                </p>
            </div>
        </MessageSection>
