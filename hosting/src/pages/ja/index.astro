---
import {getLangFromUrl} from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerticalLayout from "../../components/layout/VerticalLayout.vue";
import NavigationBar from "../../components/sections/NavigationBar.vue";
import HeroSection from "../../components/sections/HeroSection.vue";
import InfoSection from "../../components/sections/Info.vue";
import ForumSection from "@components/sections/Forum.vue";
import ExpoSection from "@components/sections/Expo.vue";
import SpeakerSection from "../../components/sections/Speakers.vue";
import SpeakersCard from "@components/sections/SpeakersCard.vue";
import TimetableSection from "../../components/sections/Timetable.vue";
import Sponsors from "../../components/sections/Sponsors.vue";
import Register from "../../components/sections/Register.vue";
import Footer from "../../components/sections/Footer.vue";
import MessageSection from "../../components/sections/Message.vue";
import TimetableEntry from "@components/sections/TimetableEntry.vue";
import TimetableEntrySection from "@components/sections/TimetableEntrySection.vue";

import DavidMessageFromPresidentImg from "../../assets/osaka-africa-business-forum/data_545.jpg";
import SackoMessageImg from "../../assets/osaka-africa-business-forum/data_330.jpg";
import ChickeImg from "../../assets/osaka-africa-business-forum/chike-c-nwoffiah.jpg";

const lang = getLangFromUrl(Astro.url);
---
<BaseLayout>
    <VerticalLayout class="md:gap-0">
        <HeroSection lang={lang} client:load></HeroSection>
        <InfoSection lang={lang} id="info">
            <span slot="title">
                アフリカのビジネス機会を探索し、つなげる。

            </span>
            <span slot="description">
                最後のフロンティアと呼ばれ世界中の経済界から注目されるアフリカ大陸と、日本とのビジネス関係構築を促進すべく2022年から毎年秋に開催してきたこのフォーラムは、昨年からビジネスだけに限らない、文化間の交流・人と人との繋がりにも焦点を当て、Africa EXPOの開催も併せた2Daysイベントへと成長しています。
                今年はさらにアフリカ各国から40社の企業が来日し、昨年よりも具体的なパートナーシップ構築や日本との文化交流促進に繋げます。（両日ともに参加無料）
            </span>
            <span slot="card-1-title">
                ビジネス機会の情報
            </span>
            <span slot="card-1-content">
               アフリカ市場に関する知識と経験を持つ厳選された専門家による基調講演、パネルディスカッション、アフリカ５地域別のブレイクアウト交流会を通じて、アフリカにおけるビジネスチャンスについて学ぶことができます。
            </span>
            <span slot="card-2-title">
               アフリカへビジネス拡大のためのつながり
            </span>
            <span slot="card-2-content">
               アフリカの大使館や各国出身の在日アフリカ人、またアフリカに関心を持つ企業、専門家とのネットワーキングの機会があります
            </span>
            <span slot="card-3-title">
                リアルなアフリカ体験
            </span>
            <span slot="card-3-content">
                アフリカの料理、ファッションショー、音楽やダンスなどのパフォーマンス、またアフリカ大使館の展示ブースを通じて、リアルなアフリカ文化を体験することができます。
            </span>
        </InfoSection>
        <ForumSection lang={lang} id="forum">
            <span slot="title">
               ビジネスフォーラム
            </span>
            <span slot="description">
                基調講演、パネルディスカッション、ワークショップなど、ハイレベルのディスカッションが行われます
            </span>

            <span slot="venue-name">
                東大阪市文化創造館
            </span>
            <span slot="venue-address">
                〒577-0034　大阪府東大阪市御厨南二丁目３番４号
            </span>

            <span slot="card-1-title">
                基調講演
            </span>
            <span slot="card-1-content">
                アフリカ市場の専門知識を持つゲストスピーカーによるアフリカのビジネス事例や発展に関するプレゼンテーション形式のセミナーです。
            </span>
            <span slot="card-2-title">
                パネルディスカッション
            </span>
            <span slot="card-2-content">
                優れた専門家や業界のリーダーたちが、アフリカにおけるビジネスの機会に関連するトピックについて、建設的な意見交換を行います。その専門性と知見に基づいて厳選されたパネリストが、アフリカ市場に対する専門知識や見解を共有し、方針や方向性についてアドバイスします。
            </span>
            <span slot="card-3-title">
               テーマ別ワークショップ
            </span>
            <span slot="card-3-content">
               アフリカ市場について深い知識を持つ業界の専門家やプロフェッショナルが主導し、参加者がインタラクティブなセッションや実践的な演習を通じて、アフリカ市場につながる価値あるスキルや戦略を得る場を提供します。
            </span>
            <span slot="card-4-title">
                ブース
            </span>
            <span slot="card-4-content">
                多目的ルームには、アフリカ大使館、スポンサー、パートナー、共同主催者、および専門機関の展示ブースが設置されます。是非、各ブースを訪れ、ビジネスの機会やアフリカの文化を発見してください。各国のアフリカ大使との交流の機会や、ご自身のネットワークの拡大、パートナーシップを築く絶好のチャンスです。
            </span>

            <span slot="register-title">
                出展を希望される方へ
            </span>
            <span slot="register-content">
                ブースの設置、パフォーマンス、食品販売や飲食店の出店等をご希望の方は、お問い合わせ」からご連絡をお願いします。
            </span>
            <span slot="register-button">
                <a href="https://forms.gle/LrEHbNAmjjBwm9Yx6"
                   class="text-sm text-white-800 font-bold mt-5 ">お問い合わせ</a>
            </span>
        </ForumSection>
        <ExpoSection lang={lang} id="expo">
            <span slot="title">
                Discover Africa Expo, Matsuri
            </span>
            <span slot="subtitle">
                リアルなアフリカ体験
            </span>
            <span slot="description">
               イベント2日目は、市民、企業、在日アフリカ大使館が、それぞれの製品、サービス、文化遺産を紹介する場となります。
            </span>

            <span slot="venue-name">
                東大阪市花園中央公園
            </span>
            <span slot="venue-address">
               〒578-0923 大阪府東大阪市松原南１丁目１−４３
            </span>

            <span slot="business-card-1-title">
                ブース
            </span>
            <span slot="business-card-1-content">
                在日アフリカ大使館によるBtoB商談会ブース。企業、海外進出支援機関を含む政府系パートナーによるブース出展
            </span>
            <span slot="business-card-2-title">
                B2B Meeting Area
            </span>
            <span slot="business-card-2-content">
             BtoBのために設けられたエリアです。このスペースでは、参加者がビジネスミーティングや商談に利用いただけます。
            </span>

            <span slot="expo-card-1-title">
                開会式
            </span>
            <span slot="expo-card-1-content">
                政府や外交関係者による歓迎スピーチが予定されています。
            </span>
            <span slot="expo-card-2-title">
               アフリカンマーケットプレイス
            </span>
            <span slot="expo-card-2-content">
                アフリカ各国の出展者が、テキスタイル、手工芸品、美術、装飾品、食品、飲料などさまざまな製品を展示します。
            </span>
            <span slot="expo-card-3-title">
                アフリカンパフォーマンス
            </span>
            <span slot="expo-card-3-content">
               伝統的な音楽を奏でるアーティストとファッションショー
            </span>
            <span slot="expo-card-4-title">
                プレゼンテーション
            </span>
            <span slot="expo-card-4-content">
               シリコンバレーアフリカ映画祭（SVAFF）の創始者Chike Nwoffiahによる「アフリカにおけるクリエイティブビジネスのポテンシャル」
            </span>

            <span slot="register-title">
                出展を希望される方へ
            </span>
            <span slot="register-content">
                ブースの設置、パフォーマンス、食品販売や飲食店の出店等をご希望の方は、お問い合わせ」からご連絡をお願いします。
            </span>
            <span slot="register-button">
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSeMVtqMWbR30hYYh92voAHezWdY3_bQmEU_MR4Kbq-uLfT0Lg/viewform"
                   class="text-sm text-white-800 font-bold mt-5 ">お問い合わせ</a>
            </span>

        </ExpoSection>
        <MessageSection lang={lang} id="message" image={DavidMessageFromPresidentImg}>
            <span slot="title"> 大切なパートナー、スポンサー、参加者の皆様へ </span>
            <p>
                在日アフリカ・ディアスポラ・ネットワーク（ADNJ）は、2024年大阪アフリカ・ビジネス・フォーラム（OABF）へのご参加を歓迎いたします。
            </p>
            <p>
                私たちは、2020年から「ディスカバー・アフリカ」プログラムを先導し、日本企業とアフリカ企業間のつながりと有意義なビジネスコラボレーションを促進してきました。
                そして、OABFの過去2年間の経験を基に、今年は「アフリカとともに歩もう!」をテーマに掲げます。
            </p>
            <p>
               2024年大阪アフリカビジネスフォーラムの第3回目は、参加者の皆様に多くの機会を提供することをお約束します。日本企業にとっては、このフォーラムが新たな事業の発見やダイナミックなアフリカ市場に関する貴重な洞察を得るための扉を開きます。
               アフリカ企業にとっては、アフリカ市場における提携や協力の機会を提供します。
            </p>
            <p>
                今年の最新イノベーションは、フォーラムの前後イベントとして、アフリカ現地の企業が10月17日から28日まで、10日間のビジネス視察訪問を行い、大阪、神戸、京都、横浜で日本企業とB2Bミーティングに参加します。
            </p>
            <p>
               スポンサー、パートナー、ボランティアとして参加することで、個人や組織の利益につながる強力なネットワークの構築に貢献することができます。力を合わせれば、明るく豊かな未来への道を切り開くことができるでしょう。
            </p>
            <p>
               皆さまの参加と貴重な貢献を心よりお待ちしております。
            </p>
             <p>
               どうぞ参加登録をしてください！皆様にお会いできることを楽しみにしております。
               敬具
            </p>
            <p slot="signature">デイビッド ポンデウ</p>
            <div slot="image-caption">
                <p class="font-bold mb-2">デイビッド ポンデウ</p>
                <p> 在日アフリカ人ネットワーク ADNJ代表 </p>
            </div>
        </MessageSection>
        <MessageSection lang={lang} image={SackoMessageImg} order="inverted">
            <span slot="title"> 皆様 </span>
            <p>
                「アフリカと共に歩こう」、これが今年の大阪アフリカビジネスフォーラムのテーマです。この機会に、アフリカとの実際の関わりを深めたいビジネスパーソンや中小企業経営者、一般の方々にご参加いただけることを心より歓迎します。
            </p>
            <p>
                アフリカは、豊かな自然資源と多様な文化が共存する大陸です。金、石油、ココア、農産物など、さまざまな資源が豊富に存在し、持続可能な経済成長を支える可能性に満ちています。
                さらに、アフリカは独自の歴史や伝統を持つ国々が集まり、国際的な視点から新たなビジネスチャンスや投資先を提供しています。

            </p>
            <p>
                特に注目すべきは、アフリカの若い人口です。50年後にはアフリカの人口が世界の4分の1を占め、その半数以上が18歳未満と予測されています。この若者たちのエネルギーと革新性は、起業や技術革新を促進し、国際的な市場での競争力を高める源となります。
                私たちがアフリカと共に歩むことは、未来の成長を見据えた重要な意味を持っています。

            </p>
            <p>
                ADNJは東大阪市との協力により、アフリカとの有意義な対話の場を提供し、互いに学び合う機会を創出します。今年の特別企画として、アフリカエキスポやアフリカフォーラムに加え、アフリカ大陸から招聘した数十名のビジネス従事者と直接交流できる機会もあります。
                この貴重なチャンスにぜひご参加いただき、アフリカの魅力を直に体感し、共に未来を築いていきましょう。
            </p>
            <p>
                アフリカと共に歩む第一歩を、一緒に踏み出しましょう。この機会を逃すことなく、新たなビジネスの可能性を探ることをお勧めします。皆様のご参加を心よりお待ちしております
            </p>
            
            <p slot="signature">ウスビ・サコ博士 </p>
            <div slot="image-caption">
                <p class="font-bold mb-2"> ウスビ・サコ博士 </p>
                <p>OABF実行委員長/2025年日本国際博覧会協会副会長
                </p>
            </div>
        </MessageSection>
