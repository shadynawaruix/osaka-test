---
import {urlHasLanguageCode} from "../i18n/utils";

let developerMessage: string | undefined;
if (import.meta.env.MODE == "development")
{
    if (!urlHasLanguageCode(Astro.url))
        developerMessage = "URLs are not rewritten for i18n in development mode. Use explicit language URLs like \"/en/\" or \"/ja/\".";
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <link rel="icon" type="image/svg+xml" href="/adnj-logo.svg"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1,user-scalable=no"/>
    <title>Page Not Found - ADNJ - Africa Business Forum - Africa Diaspora Network Japan</title>
    <style>
        body {
            font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, "Apple Color Emoji", Arial, sans-serif, "Segoe UI Emoji", "Segoe UI Symbol";
        }
    </style>
</head>
<body class="min-h-screen w-screen overflow-x-hidden">
<h2>404</h2>
<h1>Page Not Found</h1>
<p>{developerMessage}</p>
</body>
</html>
